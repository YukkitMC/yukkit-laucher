{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "download-capability",
  "description": "Lets the official LiquidBounce download page hand the file id back to the launcher",
  "remote": {
    "urls": [
      "https://liquidbounce.net",
      "https://*.liquidbounce.net",
      "https://ccbluex.net",
      "https://*.ccbluex.net"
    ]
  },
  "windows": ["download_view-*"],
  "local": false,
  "permissions": ["core:event:default"]
}
