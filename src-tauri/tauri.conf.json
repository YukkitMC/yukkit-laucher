{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yukkit Launcher",
  "version": "0.1.0",
  "identifier": "org.yukkitmc.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yukkit Launcher · LiquidBounce",
        "width": 1100,
        "height": 700,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "publisher": "YukkitMC",
    "shortDescription": "Installs, updates and starts LiquidBounce",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
