{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yukkit Launcher",
  "version": "0.2.0",
  "identifier": "org.yukkitmc.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yukkit Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        },
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https://yukkitmc.blogspot.com https://*.blogspot.com https://www.blogger.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Game",
    "publisher": "YukkitMC",
    "shortDescription": "Installs, updates and starts Yukkit Toolkit for Minecraft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "copyright": "Copyright \u00a9 2026 YukkitMC",
    "license": "MIT",
    "licenseFile": "../LICENSE"
  }
}
